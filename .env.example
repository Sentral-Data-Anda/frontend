# Base URL API eksternal (dipakai server-side untuk fetch konten dinamis).
# Tanpa trailing slash. Contoh: https://api.gkigraharaya.org/v1
# WAJIB di-set — tanpa nilai ini proses gagal start (lihat src/lib/env.ts).
API_BASE_URL=http://localhost:3001/api

# URL publik aplikasi ini (untuk metadata & canonical). Prefiks NEXT_PUBLIC_
# membuat Next meng-inline nilainya ke bundle browser saat build — di
# production WAJIB di-set ke domain asli sebelum build, bukan setelahnya.
# WAJIB di-set — tanpa nilai ini proses gagal start (lihat src/lib/env.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Opsional ---

# Origin tempat gambar disajikan (foto jemaat, galeri), kalau bukan origin
# aplikasi ini. Nilainya ditambahkan ke direktif CSP `img-src`; tanpa itu
# browser memblokir gambar dari host lain dan halaman tampak kosong tanpa
# galat yang jelas. Isi dengan origin saja, tanpa path.
# Nilai yang bukan URL http(s) diabaikan diam-diam (lihat
# src/lib/security/csp.ts). Saat `dev:mock` nilainya diisi otomatis.
# Di production WAJIB diisi kalau gambar dilayani dari domain API atau CDN.
# MEDIA_ORIGIN=https://api.gkigraharaya.org

# Nyalakan service worker saat `bun run dev`. Secara default service worker
# hanya aktif di production, karena cache basi saat pengembangan membuat
# perubahan tidak muncul dan menyesatkan. Isi "1" hanya saat memang sedang
# menguji perilaku PWA, dan jalankan dev lewat HTTPS:
#   bun run dev --experimental-https
# NEXT_PUBLIC_ENABLE_SW=1

# Menstempel versi service worker (/sw.js?v=<id>) dan build id Next. Diisi
# otomatis oleh CI dengan commit SHA; di lokal boleh dibiarkan kosong.
# Kalau kosong, next.config.ts jatuh ke `local-<timestamp>`, jadi setiap
# restart menghasilkan build id baru dan semua klien mengunduh ulang service
# worker-nya. Di production isi dengan commit SHA supaya stabil antar-restart.
# BUILD_ID=

# Port server web. Dibaca scripts/dev-mock.ts dan dihormati `next start`.
# PORT=3000
