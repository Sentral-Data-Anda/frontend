# URL publik aplikasi ini (meta Open Graph dan QR label barang). VITE_* di-inline
# ke bundel saat `vite build`: di production WAJIB diisi domain asli sebelum
# build, bukan setelahnya. Divalidasi src/lib/env-schema.ts saat build.
VITE_SITE_URL=http://localhost:3000

# --- Opsional ---

# Tujuan proxy /api dan /media milik `bun run dev` (vite.config.ts). Di
# production yang meneruskan adalah nginx (nginx/default.conf.template).
# VITE_DEV_API_TARGET=http://localhost:3001
# VITE_DEV_MEDIA_TARGET=http://localhost:9000

# Nyalakan service worker saat `bun run dev`. Secara bawaan service worker
# hanya aktif di build production, karena cache basi saat pengembangan membuat
# perubahan tidak muncul dan menyesatkan. Isi "1" hanya saat menguji PWA.
# VITE_ENABLE_SW=1

# Menstempel versi service worker (/sw.js?v=<id>). Diisi CI dengan commit SHA;
# kosong = `local-<timestamp>` per build.
# BUILD_ID=

# Port server dev. Dibaca vite.config.ts dan scripts/dev-mock.ts.
# PORT=3000

# --- Container nginx (docker-compose.yml), dibaca saat container start ---

# API_UPSTREAM=http://sada-backend:3001
# MEDIA_UPSTREAM=http://sada-minio:9000
# Rahasia bersama dengan be-sada PROXY_SHARED_SECRET (nilai sama, minimal 32
# karakter). Dengan ini be-sada mencatat alamat pengguna dari CF-Connecting-IP
# di activity log dan sesi login, bukan alamat nginx.
# BACKEND_PROXY_SECRET=
# Origin gambar bila bukan /media di origin ini; masuk ke CSP img-src.
# MEDIA_ORIGIN=
