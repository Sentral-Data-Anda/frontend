branch=$(git rev-parse --abbrev-ref HEAD)

# Blokir push langsung ke branch terproteksi.
if [ "$branch" = "development" ] || [ "$branch" = "production" ] || [ "$branch" = "main" ]; then
  echo "🚫 Direct push to '$branch' is not allowed."
  echo ""
  echo "Please create a feature branch instead."
  echo ""
  echo "Example:"
  echo "  hero-section"
  echo "  jadwal-ibadah"
  exit 1
fi

# Pola penamaan branch: huruf kecil dan angka, dipisah '-', dengan
# prefix tipe opsional yang dipisah '/' (mis. feat/pwa-2).
pattern="^[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)?$"

if ! echo "$branch" | grep -Eq "$pattern"; then
  echo "❌ Invalid branch name: $branch"
  echo ""
  echo "Branch name rules:"
  echo " - lowercase letters and numbers only"
  echo " - no uppercase letters, no spaces"
  echo " - words separated with '-'"
  echo " - optional type prefix separated with '/'"
  echo ""
  echo "Valid examples:"
  echo "  hero-section"
  echo "  jadwal-ibadah"
  echo "  feat/pwa-2"
  echo "  fix/bug-123"
  exit 1
fi

echo "✅ Branch name valid."

# Gerbang kesegaran: branch ini harus sudah memuat seluruh development.
#
# Tanpa ini, sebuah branch yang dicabang seminggu lalu tetap bisa di-push dan
# membuka PR yang hijau di CI tapi konflik atau pecah begitu digabung. Yang
# diperiksa riwayatnya, bukan berkasnya: kalau origin/development punya commit
# yang belum ada di HEAD, push ditolak.
#
# Rebase TIDAK dijalankan otomatis di sini. Rebase yang berhenti di konflik
# akan meninggalkan repo setengah jadi saat push sedang berlangsung, dan
# menyelesaikannya tetap pekerjaan tangan — jadi hook ini hanya menyebut
# perintahnya.
#
# Jalan keluar bila memang disengaja: git push --no-verify.
base="development"

echo "🔄 Fetching origin/$base..."
if ! git fetch --quiet origin "$base" 2>/dev/null; then
  # Jaringan mati atau remote tidak terjangkau. Menolak push di sini tidak ada
  # gunanya — pushnya sendiri akan gagal sebentar lagi dengan pesan yang jauh
  # lebih jelas daripada pesan hook ini.
  echo "⚠️  Tidak bisa fetch origin/$base. Pemeriksaan kesegaran dilewati."
elif ! git rev-parse --verify --quiet "origin/$base" >/dev/null; then
  echo "⚠️  origin/$base belum ada. Pemeriksaan kesegaran dilewati."
else
  behind=$(git rev-list --count "HEAD..origin/$base")

  if [ "$behind" -gt 0 ]; then
    echo "🚫 Branch '$branch' tertinggal $behind commit dari origin/$base."
    echo ""
    echo "Samakan dulu sebelum push:"
    echo ""
    echo "  git fetch origin $base"
    echo "  git rebase origin/$base"
    echo ""
    echo "Kalau rebase berhenti di konflik: selesaikan berkasnya,"
    echo "'git add' yang sudah beres, lalu 'git rebase --continue'."
    echo "Batal dengan 'git rebase --abort'."
    exit 1
  fi

  echo "✅ Sudah memuat seluruh origin/$base."
fi

# Gerbang lokal sementara.
#
# Penegakan lint/typecheck/test seharusnya tinggal di CI, dan sudah
# ditulis di .github/workflows/ci.yml. Tapi repo ini BELUM punya git remote,
# jadi CI itu belum pernah benar-benar dieksekusi. Selama itu belum terbukti
# jalan, typecheck ditahan di sini supaya tidak ada jendela di mana tidak ada
# apa pun yang menahan kode rusak.
#
# Hanya typecheck yang ditahan (~1-2 detik). Build sengaja TIDAK ditaruh di
# sini — itu pekerjaan CI, dan menunggu build penuh di setiap push membuat
# orang terbiasa memakai --no-verify.
#
# HAPUS blok ini begitu remote terpasang dan CI terbukti hijau.
echo "🔍 Running typecheck..."
if ! bun run typecheck; then
  echo ""
  echo "🚫 Typecheck gagal. Perbaiki dulu sebelum push."
  exit 1
fi

echo "✅ Pushing..."
