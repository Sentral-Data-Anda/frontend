# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Sertifikat HTTPS lokal.
#
# `bun run dev --experimental-https` (dipakai untuk menguji service worker dan
# push notification) membuat folder ini lewat mkcert dan menaruh KUNCI PRIVAT
# di dalamnya. `*.pem` di atas sudah menutup berkasnya, tapi folder ini
# diabaikan eksplisit supaya berkas lain yang ikut ditulis mkcert tidak lolos.
/certificates/

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Template variabel wajib — HARUS ikut ter-commit. src/lib/env.ts tidak punya
# .default() lagi, jadi tanpa template ini developer baru yang clone repo
# langsung kena ZodError tanpa petunjuk variabel apa yang harus diisi.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Editor & OS.
#
# Untuk .vscode berlaku kebalikan dari yang lain: seluruh isinya diabaikan,
# lalu dua berkas yang memang dipakai bersama tim dibuka kembali. Tanpa pola
# ini, launch.json atau override settings milik satu orang ikut ter-commit dan
# mengubah konfigurasi editor semua orang.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
Thumbs.db
ehthumbs.db
Desktop.ini

# Catatan kerja dan setelan agent, disimpan lokal: ditulis untuk yang sedang
# membangun, bukan untuk yang meng-clone. Dokumentasi proyek bersama ada di
# ../docs/. Keputusan yang bertahan lebih lama dari catatannya tinggal di kode
# dan di komentar migrasi.
.claude/
.superpowers/
docs/
CLAUDE.md
AGENTS.md
